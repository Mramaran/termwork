# Copy to .env and fill in. .env is git-ignored. Nothing here is a real value.
# `npm run -w scripts setup-dao`, `deploy` and `hire` write DAO_ID, MANDATE_ID and
# AGENT_PRIVATE_KEY into .env for you; you add the rest.

# ── Shared (packages/shared/src/config.ts loadConfig) ──
# Only "testnet" is accepted.
NEAR_NETWORK=testnet
# Optional. Must be https on an allowlisted testnet host (rpc.testnet.near.org,
# archival-rpc.testnet.near.org, test.rpc.fastnear.com, rpc.testnet.fastnear.com).
# Default: https://rpc.testnet.near.org (the scripts default to https://test.rpc.fastnear.com).
# NEAR_RPC_URL=
# Account that holds the mandate contract, e.g. steward.<member>.testnet. Written by `deploy`.
MANDATE_ID=
# The Sputnik DAO account, e.g. <name>.sputnikv2.testnet. Written by `setup-dao`.
DAO_ID=

# ── Signer only (never given to the agent process, which skips this variable) ──
# The agent's function-call private key, ed25519:... Written by `hire`. Do not copy it anywhere else.
AGENT_PRIVATE_KEY=
# Address the signer listens on. Must be loopback; the port is taken from this URL.
SIGNER_URL=http://127.0.0.1:8787
# Shared bearer token between the signer and the agent. Make one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SIGNER_TOKEN=

# ── Agent (agent/src/main.ts) ──
# live = ask NEAR AI Cloud; replay = reuse the stored receipts/ files, no network model call;
# fixture = deterministic rules, receipts labelled model "fixture-rules" with verified:false.
AGENT_MODE=fixture
# NEAR AI Cloud API key and model id. Needed only for AGENT_MODE=live.
NEARAI_API_KEY=
NEARAI_MODEL=
# Set to 1 to allow a model not owned by "nearai"; its receipts are then marked unverified.
NEARAI_ALLOW_UNVERIFIED=
# Where merged pull requests come from: fixtures (fixtures/prs.json) or github.
SOURCE=fixtures
# owner/name of the repository to watch. Needed only for SOURCE=github.
GITHUB_REPO=
# Required on the server for the hosted /api/analyse, /api/pay and /api/paid.
# Optional only for the local agent loop (SOURCE=github), where it just raises the API rate limit.
GITHUB_TOKEN=
# Your own testnet account, added to the DAO council by `setup-dao` (one vote then approves). Must already exist.
COUNCIL_ACCOUNT=
# Comma-separated owner/name repositories that /api/pay, /api/label and /api/paid act on.
# /api/analyse reads any public repository, and a private one if GITHUB_TOKEN can read it; this list only decides which ones get real payments.
PAYABLE_REPOS=
# GitHub token allowed to add labels to pull requests, used by the hosted /api/label.
GITHUB_LABEL_TOKEN=
# Milliseconds between agent ticks. Default 30000.
LOOP_INTERVAL_MS=30000

# ── Scripts (scripts/src) ──
# Testnet faucet used to fund the council accounts. Default: https://helper.nearprotocol.com/account
# NEAR_FAUCET_URL=
# `npm run -w scripts demo`: length of the demo term in seconds (default 300) and agent tick in ms (default 5000).
DEMO_TERM_SECS=300
DEMO_TICK_MS=5000

# ── Web (read by Vite from this file; envDir is the repo root) ──
VITE_MANDATE_ID=
# Must equal DAO_ID above (the site and the server must point at the same DAO).
VITE_DAO_ID=
VITE_NETWORK=testnet
# Optional. Same allowlist as NEAR_RPC_URL.
# VITE_NEAR_RPC_URL=
# Build-time only: URL path the site is served from. The Pages workflow sets it to /<repo-name>/. Leave empty locally.
# BASE_PATH=
